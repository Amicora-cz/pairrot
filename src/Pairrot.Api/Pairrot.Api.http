@host = http://localhost:5034
# Keys printed by: dotnet run --project src/Pairrot.Admin -- setup
@tenantKey = prt_replace_me
@managementKey = prt_replace_me
@childId = 00000000-0000-0000-0000-000000000000

GET {{host}}/health

###
GET {{host}}/v1/tenant
Authorization: Bearer {{tenantKey}}

###
PATCH {{host}}/v1/tenant/configuration
Authorization: Bearer {{tenantKey}}
Content-Type: application/json

{
  "contact_email": "info@example.com"
}

###
POST {{host}}/v1/subtenants
Authorization: Bearer {{managementKey}}
Content-Type: application/json

{
  "external_id": "studio_123",
  "name": "Studio Balance",
  "contact_email": "studio@example.com"
}

###
GET {{host}}/v1/subtenants?limit=50
Authorization: Bearer {{managementKey}}

###
PATCH {{host}}/v1/subtenants/{{childId}}
Authorization: Bearer {{managementKey}}
Content-Type: application/json

{
  "status": "suspended"
}

###
POST {{host}}/v1/subtenants/{{childId}}/api-keys
Authorization: Bearer {{managementKey}}
Content-Type: application/json

{
  "label": "rotation"
}

###
GET {{host}}/v1/subtenants/{{childId}}/api-keys
Authorization: Bearer {{managementKey}}

###
DELETE {{host}}/v1/subtenants/{{childId}}
Authorization: Bearer {{managementKey}}

### Browser sessions (Feature 2) need HTTPS because the session cookie is Secure.
### Run the API with --launch-profile https. The client keeps cookies between requests.
@https = https://localhost:7017
@antiforgeryToken = replace_with_token_from_antiforgery_response
@tenantId = replace_with_selected_tenant_id

GET {{https}}/v1/auth/antiforgery

###
POST {{https}}/v1/auth/login
X-XSRF-TOKEN: {{antiforgeryToken}}
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "your password"
}

### Get a new antiforgery token after login; it is bound to the signed-in user.
GET {{https}}/v1/auth/session

###
GET {{https}}/v1/tenant/api-keys
X-Pairrot-Tenant-Id: {{tenantId}}

###
POST {{https}}/v1/tenant/api-keys
X-XSRF-TOKEN: {{antiforgeryToken}}
X-Pairrot-Tenant-Id: {{tenantId}}
Content-Type: application/json

{
  "purpose": "management",
  "label": "issued in the browser"
}

###
GET {{https}}/v1/tenant/audit-events?limit=20
X-Pairrot-Tenant-Id: {{tenantId}}

### Bank connections (Feature 3): the same routes exist under /v1/subtenants/{{childId}}/bank-connections.
@connectionId = replace_with_connection_id
@paymentRequestId = replace_with_payment_request_id

POST {{https}}/v1/tenant/bank-connections
X-XSRF-TOKEN: {{antiforgeryToken}}
X-Pairrot-Tenant-Id: {{tenantId}}
Content-Type: application/json

{
  "account_number": "19-2000145399/0800",
  "label": "Main account"
}

###
GET {{https}}/v1/tenant/bank-connections?include_archived=true
X-Pairrot-Tenant-Id: {{tenantId}}

###
POST {{https}}/v1/tenant/bank-connections/{{connectionId}}/inbound-address
X-XSRF-TOKEN: {{antiforgeryToken}}
X-Pairrot-Tenant-Id: {{tenantId}}

###
GET {{host}}/v1/subtenants/{{childId}}/bank-connections
Authorization: Bearer {{managementKey}}

### Payment QR (Feature 4): JSON payment data and SPAYD payload; the same body at .../payment-qr.png returns the image.
POST {{https}}/v1/tenant/bank-connections/{{connectionId}}/payment-qr
X-XSRF-TOKEN: {{antiforgeryToken}}
X-Pairrot-Tenant-Id: {{tenantId}}
Content-Type: application/json

{
  "amount": 45000,
  "currency": "CZK",
  "variable_symbol": "0000123456",
  "message": "Yoga October"
}

###
POST {{host}}/v1/subtenants/{{childId}}/bank-connections/{{connectionId}}/payment-qr.png
Authorization: Bearer {{managementKey}}
Content-Type: application/json

{
  "amount": 45000,
  "currency": "CZK"
}

### Expected payment (Feature 5). Repeating the same body returns the existing request with 200 and "replayed": true.
POST {{host}}/v1/tenant/payment-requests
Authorization: Bearer {{tenantKey}}
Content-Type: application/json

{
  "bank_connection_id": "{{connectionId}}",
  "external_id": "booking_123",
  "amount": 45000,
  "currency": "CZK",
  "variable_symbol": "2026000123",
  "message": "Yoga October",
  "description": "Reservation booking_123",
  "due_at": "2026-10-15T18:00:00+02:00"
}

### Feature 12: without variable_symbol, Pairrot assigns the next unused one of the connection. Retry without it too.
POST {{host}}/v1/tenant/payment-requests
Authorization: Bearer {{tenantKey}}
Content-Type: application/json

{
  "bank_connection_id": "{{connectionId}}",
  "external_id": "booking_124",
  "amount": 45000,
  "currency": "CZK",
  "message": "Yoga October"
}

###
GET {{host}}/v1/tenant/payment-requests?external_id=booking_123
Authorization: Bearer {{tenantKey}}

### The ETag of GET .../{id} is the version to send in If-Match.
PATCH {{host}}/v1/tenant/payment-requests/{{paymentRequestId}}
Authorization: Bearer {{tenantKey}}
If-Match: "1"
Content-Type: application/json

{
  "due_at": "2026-10-20T18:00:00+02:00"
}

###
GET {{host}}/v1/tenant/payment-requests/{{paymentRequestId}}/qr.png
Authorization: Bearer {{tenantKey}}

###
POST {{host}}/v1/tenant/payment-requests/{{paymentRequestId}}/cancel
Authorization: Bearer {{tenantKey}}
If-Match: "2"
Content-Type: application/json

{
  "reason": "Reservation cancelled"
}

### Inbound email (Feature 6): messages routed to this tenant; quarantined mail is visible only in the admin CLI.
@inboundMessageId = replace_with_inbound_message_id

GET {{host}}/v1/tenant/inbound-messages?content_state=failed&hold_reason=none
Authorization: Bearer {{tenantKey}}

### Stored source (text, escaped HTML, headers, sender authentication); never fetched from the provider again.
GET {{host}}/v1/tenant/inbound-messages/{{inboundMessageId}}/source
Authorization: Bearer {{tenantKey}}

### After a failed retrieval: 202 with the queued job, or the one already queued.
POST {{host}}/v1/tenant/inbound-messages/{{inboundMessageId}}/retry-fetch
Authorization: Bearer {{tenantKey}}

###
POST {{https}}/v1/auth/logout
X-XSRF-TOKEN: {{antiforgeryToken}}
